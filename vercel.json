{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/club-fittings",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/club-fittings.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/store",
      "destination": "/gift-cards",
      "permanent": true
    },
    {
      "source": "/store.html",
      "destination": "/gift-cards",
      "permanent": true
    },
    {
      "source": "/pricinghours",
      "destination": "/hours-pricing",
      "permanent": true
    },
    {
      "source": "/coaching-pricing",
      "destination": "/coaching-clinics",
      "permanent": true
    },
    {
      "source": "/club-membership",
      "destination": "/memberships",
      "permanent": true
    },
    {
      "source": "/clubfitting",
      "destination": "/coaching-clinics",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/league-admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/league-admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "23 15 * * *"
    }
  ]
}
